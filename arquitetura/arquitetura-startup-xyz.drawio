        <mxCell id="ft2" value="&lt;b&gt;WAF e API:&lt;/b&gt; a requisição passa pelo WAF e chega ao API Gateway, que valida o JWT." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="1546" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="fb3" value="4" style="ellipse;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="1570" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="ft3" value="&lt;b&gt;URL:&lt;/b&gt; a Lambda monta a chave com o sub, consulta os metadados e assina a URL pré-assinada com a role IAM (expira em 5 min)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="1572" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="fb4" value="5" style="ellipse;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="1596" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="ft4" value="&lt;b&gt;PDF direto no S3:&lt;/b&gt; o cliente envia (PUT) ou baixa (GET) o arquivo sem passar pela Lambda." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="1598" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="fb5" value="6" style="ellipse;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="1622" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="ft5" value="&lt;b&gt;Evento:&lt;/b&gt; o S3 publica ObjectCreated no EventBridge." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="1624" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="fb6" value="7" style="ellipse;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="1648" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="ft6" value="&lt;b&gt;Fila:&lt;/b&gt; o EventBridge entrega o evento ao SQS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="1650" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="fb7" value="8" style="ellipse;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="1674" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="ft7" value="&lt;b&gt;Metadado:&lt;/b&gt; a Lambda de metadados grava o registro no DynamoDB, que replica para us-west-2." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="1676" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="fb8" value="!" style="ellipse;html=1;fillColor=#D13212;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="1700" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="ft8" value="&lt;b&gt;Falha:&lt;/b&gt; depois de várias tentativas, a mensagem desce para a DLQ e o alarme avisa a equipe por e-mail." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="1702" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="fb9" value="DR" style="ellipse;html=1;fillColor=#8C4FFF;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="1726" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="ft9" value="&lt;b&gt;Desastre:&lt;/b&gt; se o health check falhar, o Route 53 aponta para us-west-2 e a API sobe por IaC sobre os dados já replicados." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="1728" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="leg_t" value="&lt;b&gt;Tipos de seta&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1300" y="1460" width="300" height="24" as="geometry" /></mxCell>
        <mxCell id="le0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=12;fontStyle=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=1.8;fontColor=#232F3E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1504" as="sourcePoint" /><mxPoint x="1350" y="1504" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lt0" value="Requisição" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1362" y="1494" width="540" height="20" as="geometry" /></mxCell>
        <mxCell id="le1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=12;fontStyle=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#3F8624;strokeWidth=1.8;fontColor=#3F8624;dashed=1;dashPattern=7 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1530" as="sourcePoint" /><mxPoint x="1350" y="1530" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lt1" value="Acesso direto ao S3 (URL pré-assinada)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1362" y="1520" width="540" height="20" as="geometry" /></mxCell>
        <mxCell id="le2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=12;fontStyle=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#D13212;strokeWidth=1.8;fontColor=#D13212;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1556" as="sourcePoint" /><mxPoint x="1350" y="1556" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lt2" value="Falha e alerta" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1362" y="1546" width="540" height="20" as="geometry" /></mxCell>
        <mxCell id="le3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=12;fontStyle=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#ED7100;strokeWidth=2.2;fontColor=#ED7100;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1582" as="sourcePoint" /><mxPoint x="1350" y="1582" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lt3" value="Replicação entre regiões (Cognito, DynamoDB e S3)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1362" y="1572" width="540" height="20" as="geometry" /></mxCell>
        <mxCell id="le4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=12;fontStyle=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#8C4FFF;dashed=1;dashPattern=10 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1608" as="sourcePoint" /><mxPoint x="1350" y="1608" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lt4" value="Failover de DNS (Route 53)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1362" y="1598" width="540" height="20" as="geometry" /></mxCell>
        <mxCell id="leg_n" value="Ícones esmaecidos e setas cinza: só passam a existir no failover (criados por IaC)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#545B64;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1300" y="1632" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="rto" value="&lt;b style=&quot;font-size:13px&quot;&gt;Metas de recuperação (região secundária)&lt;/b&gt;&lt;br&gt;&lt;b&gt;RPO:&lt;/b&gt; minutos nos documentos (CRR). Quase tempo real nos metadados (Global Tables) e nos usuários (Cognito).&lt;br&gt;&lt;b&gt;RTO:&lt;/b&gt; horas. O DNS vira em poucos minutos, mas a API precisa subir por IaC.&lt;br&gt;&lt;b&gt;Cognito no failover:&lt;/b&gt; o login segue com o mesmo usuário e senha. Cadastro novo, troca de senha e MFA TOTP só voltam com a primária." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#EEF7F8;strokeColor=#00A4A6;strokeWidth=1.4;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1300" y="1662" width="600" height="150" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
