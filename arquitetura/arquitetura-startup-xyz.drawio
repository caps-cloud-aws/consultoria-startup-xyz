        <mxCell id="ft1" value="&lt;b&gt;DNS:&lt;/b&gt; o app chama api.startupxyz.com e o Route 53 responde com a API da região saudável." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="262" y="1520" width="1000" height="20" as="geometry" /></mxCell>
