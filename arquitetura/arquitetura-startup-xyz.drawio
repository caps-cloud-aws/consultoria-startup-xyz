        <mxCell id="cw" value="&lt;b style=&quot;font-size:15px&quot;&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;logs, métricas e alarmes&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;labelWidth=205;" vertex="1" parent="1"><mxGeometry x="345" y="380" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="waf" value="&lt;b style=&quot;font-size:15px&quot;&gt;AWS WAF&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;Web ACL regional&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;rate limit · regras gerenciadas&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;na REST API e no Cognito&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;labelWidth=205;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="apigw" value="&lt;b style=&quot;font-size:15px&quot;&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;REST API · domínio próprio&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;Cognito authorizer · throttling&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;rota /health sem autenticação&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;labelWidth=205;" vertex="1" parent="1"><mxGeometry x="775" y="380" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="lapi" value="&lt;b style=&quot;font-size:15px&quot;&gt;Lambda (API)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;chave = prefixo do sub&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;gera e assina a URL (5 min)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;role IAM · não chama o S3&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelWidth=200;" vertex="1" parent="1"><mxGeometry x="990" y="380" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="cog" value="&lt;b style=&quot;font-size:15px&quot;&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;User Pool · emite JWT&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;protegido pelo WAF&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;Essentials · réplica&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="1205" y="380" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="sns" value="&lt;b style=&quot;font-size:15px&quot;&gt;Amazon SNS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;tópico de alerta&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;labelWidth=205;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="345" y="580" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="lmeta" value="&lt;b style=&quot;font-size:15px&quot;&gt;Lambda (metadados)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;idempotente · ARM&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelWidth=170;" vertex="1" parent="1"><mxGeometry x="990" y="580" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="ddb" value="&lt;b style=&quot;font-size:15px&quot;&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;metadados (PK userId)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;on-demand · PITR&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;Global Table&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="1205" y="580" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="alarm" value="&lt;b style=&quot;font-size:15px&quot;&gt;Alarme CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;DLQ com mensagem &amp;gt; 0&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;labelWidth=205;" vertex="1" parent="1"><mxGeometry x="345" y="860" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="dlq" value="&lt;b style=&quot;font-size:15px&quot;&gt;SQS (DLQ)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;mensagens com falha&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;labelWidth=205;" vertex="1" parent="1"><mxGeometry x="560" y="860" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="sqs" value="&lt;b style=&quot;font-size:15px&quot;&gt;Amazon SQS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;fila padrão&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;labelWidth=205;" vertex="1" parent="1"><mxGeometry x="775" y="860" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="eb" value="&lt;b style=&quot;font-size:15px&quot;&gt;EventBridge&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;regra ObjectCreated&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;notificação ativada no bucket&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;labelWidth=205;" vertex="1" parent="1"><mxGeometry x="990" y="860" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Amazon S3 · 3+ AZs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;privado · Block Public Access&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;versionado · Object Lock&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;SSE-S3 · só HTTPS&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;Standard → Deep Archive (365 d)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;DELETE negado&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelWidth=200;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1205" y="860" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="elastic" value="&lt;b style=&quot;font-size:14px&quot;&gt;Elasticidade: escala sob demanda, sem servidor&lt;/b&gt;&lt;br&gt;Lambda, API Gateway, SQS, S3 e DynamoDB on-demand aumentam e diminuem sozinhos com o volume e não cobram por capacidade parada.&lt;br&gt;Carga do case: 50 mil arquivos por mês, cerca de 1,2 upload por minuto. Picos ficam na fila (SQS) e são processados sem perda.&lt;br&gt;Ponto de atenção: cota de concorrência da Lambda (aumentável) e throttling do API Gateway." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#F2F8EC;strokeColor=#3F8624;strokeWidth=1.4;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="330" y="1013" width="1000" height="104" as="geometry" /></mxCell>
        <mxCell id="on" value="" style="rounded=1;arcSize=1;html=1;strokeColor=#7AA116;fillColor=none;strokeWidth=1.2;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1434" y="335" width="166" height="680" as="geometry" /></mxCell>
        <mxCell id="on_t" value="&lt;b&gt;Ligado&lt;/b&gt;&lt;br&gt;dados replicados" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#3F8624;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1436" y="341" width="162" height="32" as="geometry" /></mxCell>
        <mxCell id="cog2" value="&lt;b style=&quot;font-size:15px&quot;&gt;Cognito réplica&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;mesmo user pool ID&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;chave KMS multi-região&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="1480" y="380" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="ddb2" value="&lt;b style=&quot;font-size:15px&quot;&gt;DynamoDB réplica&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;Global Table&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;dois sentidos&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelWidth=150;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1480" y="580" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="s32" value="&lt;b style=&quot;font-size:15px&quot;&gt;S3 réplica · 3+ AZs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;Standard → Deep Archive&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;(365 d) · Object Lock&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;antigos: Batch Replication&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="1480" y="860" width="64" height="64" as="geometry" /></mxCell>
        <mxCell id="off" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F8F8F8;strokeColor=#879196;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1606" y="380" width="279" height="575" as="geometry" /></mxCell>
        <mxCell id="off_note" value="&lt;b&gt;Desligado:&lt;/b&gt; sobe por IaC (CloudFormation) no failover. Domínio da API e certificado ACM já ficam criados. No failover, a Lambda gera as URLs para o S3 réplica." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#545B64;fontStyle=0;strokeColor=none;fillColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="1612" y="388" width="267" height="100" as="geometry" /></mxCell>
        <mxCell id="lapi2" value="&lt;b style=&quot;font-size:12px&quot;&gt;Lambda (API)&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelWidth=90;opacity=45;" vertex="1" parent="1"><mxGeometry x="1630" y="588" width="48" height="48" as="geometry" /></mxCell>
