        <mxCell id="svc_t" value="&lt;b&gt;Serviços regionais gerenciados · multi-AZ automático&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;fontColor=#3F8624;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="660" y="338" width="500" height="20" as="geometry" /></mxCell>
        <mxCell id="ha_t" value="&lt;b&gt;Alta disponibilidade na região:&lt;/b&gt; a AWS distribui esta camada nas AZs a, b e c. Não implantamos três Lambdas nem escolhemos a AZ." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#3F8624;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="1126" width="860" height="18" as="geometry" /></mxCell>
